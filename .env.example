# API key for OpenAI API (https://platform.openai.com/account/api-keys)
OPENAI_API_KEY=
MODEL_ID=gpt-6-luna
# Intent router + reply rewriter model (empty = MODEL_ID)
ROUTER_MODEL_ID=gpt-6-luna
# Max tool calls of the order agent per message
AGENT_TOOL_CALL_LIMIT=5
ORDER_API_BASE_URL=http://localhost:8000/api
ORDER_API_TIMEOUT_SECONDS=5
# Agent -> Menu service (started automatically by `uv run delivery-agent` unless already running)
MENU_SERVICE_BASE_URL=http://127.0.0.1:8081
MENU_SERVICE_TIMEOUT_SECONDS=5
MENU_SERVICE_AUTOSTART=true
SESSION_TIMEOUT_MINUTES=15
NUM_HISTORY_RUNS=5
# Of those runs, keep only the last N tool calls (and results). Both limits apply only without OpenAI response
# chaining, which is kept for cost (specs/007-short-replies)
AGENT_MAX_TOOL_CALLS_FROM_HISTORY=3
TIMEZONE=America/Sao_Paulo
AGENT_DB_PATH=data/agent.db
# --- Guardrails ---
HUMAN_HANDOFF_THRESHOLD=3
HUMAN_ATTENDANT_DB_PATH=data/human_attendant.db
# One row per customer message: intent, route, first message of the day (specs/004-greeting)
INTENT_DB_PATH=data/intent.db
# --- Special dates (specs/005-special-dates) ---
# SPECIAL_DATES_PATH=src/delivery_agent/domain/special_dates.json
SPECIAL_DATES_WINDOW_DAYS=10
# GUARDRAIL_TERMS_PATH=src/delivery_agent/guardrails/terms.json
# --- Menu service ---
MENU_SERVICE_HOST=127.0.0.1
MENU_SERVICE_PORT=8081
# Set to require the X-Admin-Token header on PUT/DELETE /menu/items
MENU_ADMIN_TOKEN= # No obligation to set this, but recommended for production. Use a strong random string.
EMBEDDING_MODEL_ID=text-embedding-3-small
KB_SQL_PATH=knowledge_base/knowledge_base.sql
MENU_DB_PATH=data/menu.db
VECTOR_DB_PATH=data/lancedb
SEMANTIC_MAX_DISTANCE=0.75
HOST=127.0.0.1
PORT=8080
# DEBUG traces each step: prompts, model calls, tool calls/results, Order API calls (CPFs masked)
LOG_LEVEL=INFO # INFO | DEBUG
# Colored logs: auto (terminal only, honors NO_COLOR) | always | never
LOG_COLOR=auto
# --- Langfuse tracing (specs/006-langfuse-tracing) ---
# One trace per customer message (CPFs masked, user id pseudonymized). On when true AND both keys are set;
# set to false to turn tracing off without removing the keys.
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
# EU: https://cloud.langfuse.com | US: https://us.cloud.langfuse.com | self-hosted: http://localhost:3000
LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
# Separates test traces from production ones (lowercase letters, digits, - or _)
LANGFUSE_TRACING_ENVIRONMENT=development
# Share of messages traced, 0.0 to 1.0
LANGFUSE_SAMPLE_RATE=1.0
